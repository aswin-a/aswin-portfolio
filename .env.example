# Anthropic (SPEC §13). Model IDs must have a price row in lib/ai/cost.ts.
ANTHROPIC_API_KEY=
FIT_CHECK_MODEL=claude-sonnet-5-5
CHAT_MODEL=claude-haiku-5-5
FIT_DAILY_LIMIT=10
MONTHLY_BUDGET_USD=20

# Upstash Redis: rate limits and the monthly budget counter. Required on Vercel; a local
# server without them uses an in-memory store.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (invisible widget). Required for every AI call. For local dev with a real
# model, Cloudflare's test keys work: site 1x00000000000000000000BB, secret 1x0000000000000000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Supabase: run metrics only (supabase/migrations/0001_runs.sql). Service role key is server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend: the contact form (SPEC §9). CONTACT_FROM_EMAIL must be on a domain verified in Resend,
# e.g. "Aswin's site <contact@aswin-a.com>". Messages go to CONTACT_TO_EMAIL with reply-to = the sender.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# PostHog, cookieless (cookieless_mode "always"): turn on cookieless mode in the PostHog project
# settings, or its events are dropped. Host e.g. https://eu.i.posthog.com. Unset = no analytics.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Random 32-byte hex; salts the visitor hash used for rate limits.
IP_HASH_SALT=

# Tests only: deterministic fake model, no keys needed. Refused when VERCEL_ENV=production. Never set on Vercel.
AI_FAKE=
